{
  "name": "classgrid",
  "version": "1.0.0",
  "description": "ClassGrid is a school timetable management platform for scheduling classes, teachers, subjects, rooms, and periods while detecting scheduling conflicts and managing timetable versions.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "db:dev:init": "tsx src/config/db.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "seed": "tsx src/seed/index.ts",
    "seed:admin": "tsx src/seed/admin.seed.ts",
    "seed:config": "tsx src/seed/config.seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "prisma": "^7.10.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "MUSA MUHAMMED AWWAL",
  "license": "UNLICENSED"
}
