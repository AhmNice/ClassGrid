{
  "name": "classgrid",
  "version": "1.0.0",
  "description": "ClassGrid is a school timetable management platform for scheduling classes, teachers, subjects, rooms, and periods while detecting scheduling conflicts and managing timetable versions.",
  "main": "index.js",
  "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi",
  "type": "module",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "todos": "node scripts/scan-todos.mjs src",
    "todos:fail": "node scripts/scan-todos.mjs src --fail ",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "jwt:generate": "tsx src/g.ts",
    "db:dev:init": "tsx src/config/db.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "seed": "tsx src/seed/index.ts",
    "seed:admin": "tsx src/seed/admin.seed.ts",
    "seed:config": "tsx src/seed/config.seed.ts"
  },
  "overrides": {
    "braces": "^3.0.3",
    "deepmerge-ts": "^7.1.5",
    "mysql2": "^3.12.0",
    "sprintf-js": "^1.1.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "github:asteasolutions/zod-to-openapi",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "sanitize-html": "^2.18.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.14",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "keywords": [],
  "author": "MUSA MUHAMMED AWWAL",
  "license": "UNLICENSED"
}
